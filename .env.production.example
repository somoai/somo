# ==============================================================================
# SomoAI Backend - Production Environment Variables
# ==============================================================================
#
# IMPORTANT:
# - Copy this file to .env and fill in actual values
# - NEVER commit the actual .env file to version control!
# - Railway will inject most of these automatically
#
# ==============================================================================

# ==============================================================================
# Django Configuration
# ==============================================================================

# CRITICAL: Generate a strong secret key for production
# Generate with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-CHANGE-THIS

# Environment
DJANGO_SETTINGS_MODULE=somoai_backend.settings_production
DEBUG=False

# Allowed hosts (comma-separated)
ALLOWED_HOSTS=api.somoai.co.ke,somoai-backend.railway.app,.railway.app

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================

# Railway automatically provides these variables:
# PGDATABASE=railway
# PGUSER=postgres
# PGPASSWORD=auto-generated-password
# PGHOST=postgres.railway.internal
# PGPORT=5432

# Alternative: Single DATABASE_URL (Railway provides this automatically)
# DATABASE_URL=postgresql://user:password@host:port/database

# ==============================================================================
# Redis Configuration
# ==============================================================================

# Railway automatically provides this when Redis is added:
# REDIS_URL=redis://default:password@redis.railway.internal:6379

# ==============================================================================
# Africa's Talking SMS Configuration
# ==============================================================================

# Get your credentials from https://account.africastalking.com/
AFRICAS_TALKING_API_KEY=your-production-api-key-here
AFRICAS_TALKING_USERNAME=your-username
AFRICAS_TALKING_SHORTCODE=22500

# SMS sender name/number
SMS_DEFAULT_FROM=22500

# ==============================================================================
# Email Configuration
# ==============================================================================

# Gmail SMTP (or use your preferred email service)
EMAIL_HOST_USER=somoai@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

# Admin email for error notifications
ADMIN_EMAIL=admin@somoai.co.ke

# ==============================================================================
# OpenAI Configuration (AI Tutoring)
# ==============================================================================

# Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# ==============================================================================
# Security & HTTPS
# ==============================================================================

# These should always be True in production
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ==============================================================================
# CORS Configuration
# ==============================================================================

# Allowed origins for CORS (comma-separated)
CORS_ALLOWED_ORIGINS=https://somoai.co.ke,https://www.somoai.co.ke,https://app.somoai.co.ke

# ==============================================================================
# Monitoring & Error Tracking (Optional)
# ==============================================================================

# Sentry DSN for error tracking (optional)
# Get from https://sentry.io/
# SENTRY_DSN=https://your-sentry-dsn-here

# ==============================================================================
# Custom Application Settings
# ==============================================================================

# Learning engine settings
MAX_QUESTIONS_PER_LESSON=5
MASTERY_THRESHOLD=0.8

# Rate limits
SMS_DAILY_LIMIT_PER_USER=50
API_DAILY_LIMIT_PER_USER=1000

# ==============================================================================
# Notes for Railway Deployment
# ==============================================================================
#
# 1. Railway automatically provides:
#    - PGDATABASE, PGUSER, PGPASSWORD, PGHOST, PGPORT (when PostgreSQL is added)
#    - REDIS_URL (when Redis is added)
#    - PORT (for the web server)
#
# 2. You need to manually set in Railway:
#    - SECRET_KEY
#    - AFRICAS_TALKING_* variables
#    - EMAIL_* variables
#    - OPENAI_API_KEY
#    - ALLOWED_HOSTS (if using custom domain)
#
# 3. Set variables in Railway:
#    railway variables set SECRET_KEY="your-secret-key"
#    railway variables set AFRICAS_TALKING_API_KEY="your-key"
#    # ... etc
#
# 4. Or use the Railway dashboard:
#    Project > Variables > New Variable
#
# ==============================================================================
